{
  "name": "ozon-mcp-kirillshsh",
  "version": "0.1.0",
  "description": "Ozon MCP server: search, product cards, reviews with photos, Q&A, your own orders and your cart — logs in with your own browser cookies.",
  "type": "module",
  "bin": {
    "ozon": "./bin/install.mjs",
    "ozon-install": "./bin/install.mjs",
    "ozon-login": "./bin/login.mjs"
  },
  "files": [
    ".codex-plugin/plugin.json",
    "README.md",
    "assets/**",
    "bin/*.mjs",
    "requirements.txt",
    "scripts/**/*.py",
    "skills/**/SKILL.md"
  ],
  "scripts": {
    "install:local": "node ./bin/install.mjs",
    "install:local:skip-login": "node ./bin/install.mjs --skip-login",
    "login": "node ./bin/login.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "ozon",
    "mcp",
    "claude",
    "marketplace",
    "reviews"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirillshsh/ozon.git"
  }
}
