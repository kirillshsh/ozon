{
  "name": "ozon",
  "version": "0.1.0",
  "description": "Ozon MCP plugin: search, catalogue, full product cards, reviews with photos, product Q&A, and read-only account data.",
  "type": "module",
  "bin": {
    "ozon": "./bin/install.mjs",
    "ozon-install": "./bin/install.mjs",
    "ozon-login": "./bin/login.mjs"
  },
  "files": [
    ".codex-plugin/plugin.json",
    "assets/**",
    "bin/*.mjs",
    "skills/**/SKILL.md",
    "scripts/**/*.py",
    ".mcp.json",
    "README.md",
    "requirements.txt"
  ],
  "scripts": {
    "install:local": "node ./bin/install.mjs",
    "install:local:skip-login": "node ./bin/install.mjs --skip-login",
    "login": "node ./bin/login.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
