{
  "name": "marketplaces",
  "version": "0.1.0",
  "description": "Codex MCP plugin for Ozon and Wildberries product search, cards, photos, and reviews.",
  "type": "module",
  "bin": {
    "marketplaces": "./bin/install.mjs",
    "marketplaces-install": "./bin/install.mjs"
  },
  "files": [
    ".codex-plugin/plugin.json",
    "bin/install.mjs",
    "skills/**/SKILL.md",
    "scripts/**/*.py",
    ".mcp.json",
    "README.md",
    "requirements.txt"
  ],
  "scripts": {
    "install:local": "node ./bin/install.mjs",
    "install:local:skip-login": "node ./bin/install.mjs --skip-login",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
